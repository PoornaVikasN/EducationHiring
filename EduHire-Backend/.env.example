# School Teacher API — Environment Variables
# Copy to .env and fill in real values. Never commit .env*.
#
# Most integration secrets below (Gmail, AWS, Razorpay, reCAPTCHA) are ALSO editable
# live via Admin → Config → API Keys once the app is running — that DB-stored value
# takes priority over whatever's here. Still fill these in for the app's FIRST boot
# against a fresh database, since a couple of them (Gmail, AWS, Razorpay) are required
# at boot-validation time in production (see src/config/env.validation.ts).

# === GENERAL ===
NODE_ENV=development
SERVER_PORT=3001
# Every scheduled cron in this app (@Cron decorators) is evaluated against this
# timezone unless a schedule explicitly pins its own — currently only the bulk-import
# email sweep does (Asia/Kolkata). Leaving this at UTC means "3 AM" in any OTHER
# schedule added later will mean 3 AM UTC / 8:30 AM IST, not 3 AM India time — pin an
# explicit `timeZone` on the @Cron() call for anything anchored to a specific hour.
TZ=UTC
CORS_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com,http://localhost:3000
# Set in prod when FE and API live on different subdomains of the same eTLD+1,
# e.g. ".your-production-domain.com" for FE on your-production-domain.com and API on
# api.your-production-domain.com. Leave blank in development (cookie defaults to the
# request host).
COOKIE_DOMAIN=
# Public-facing frontend URL used in outbound links (activation emails, alert emails,
# WhatsApp templates). Update the default in env.validation.ts too if your real domain
# differs — code falls back to that default when this is unset.
PUBLIC_FRONTEND_URL=https://your-production-domain.com

# === MONGODB ATLAS ===
# URI is built in app.module.ts (buildMongoUri()) from these four parts.
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=
MONGO_DB_HOST=                              # e.g. cluster0.xxxxx.mongodb.net
MONGO_DB_NAME=eduhire
# Atlas → Network Access must allow the server's outbound IP (or 0.0.0.0/0 for a
# dev-only cluster) — a wrong/missing allow-list entry is the most common
# "MongoServerSelectionError" cause when pointing at a brand-new cluster.

# === FIRST-ADMIN BOOTSTRAP ===
# On a fresh, empty database, the backend auto-creates exactly one admin account
# using these two values (see AppService.seedAdmin) — idempotent, so it's a safe
# no-op on every later boot once that account exists. Set both before the FIRST
# boot against a new database; safe to leave unset afterward (or even remove from
# .env once you've logged in — seeding is skipped, with a warning logged, if either
# is missing).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# === JWT — dual-token (access + refresh with rotation) ===
# Generate each secret independently: `openssl rand -hex 32`
JWT_ACCESS_SECRET=                          # ≥32 chars, keep private
JWT_REFRESH_SECRET=                         # ≥32 chars, DIFFERENT from ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === CONFIG ENCRYPTION (SystemConfig api_key field) ===
# ≥32 chars, MUST differ from JWT secrets. Generate: `openssl rand -hex 32`
# WARNING: rotating this key makes existing encrypted SystemConfig api_keys unreadable;
# admin must re-enter them via Admin → Config → API Keys (Razorpay, AWS, Gmail, etc.).
CONFIG_ENCRYPTION_KEY=

# === GOOGLE OAuth (Sign in with Google) ===
# Only GOOGLE_CLIENT_ID is actually read by the backend (ID-token audience check) —
# the frontend does implicit OAuth and sends a token directly, no server-side
# auth-code exchange. CLIENT_SECRET/CALLBACK_URL are unused by this flow but kept
# here since the same OAuth client is also used for Gmail sending below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# === GOOGLE MAPS / PLACES (location autocomplete + map picker) ===
# Confirmed unused by any backend code path — location autocomplete runs entirely in
# the browser via the FRONTEND's NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (a SEPARATE key with
# its own HTTP-referrer restrictions — see EduHire-Frontend/.env.example). This var is
# only kept here because it's registered as an editable Admin → Config → API Keys
# entry; setting it currently has no functional effect. Leave blank.
GOOGLE_MAPS_API_KEY=

# === Gmail SMTP via nodemailer OAuth2 ===
# Generate the refresh token at: https://developers.google.com/oauthplayground
# — check "Use your own OAuth credentials" (gear icon) with the Client ID/Secret
# above, and authorize scope https://mail.google.com/ specifically. Skipping either
# of those two steps is the most common cause of an invalid/rejected token.
GMAIL_USER=                                 # e.g. noreply@your-business-domain.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SMTP_SENDER_NAME=SchoolTeacher
# A regular (non-Workspace) Gmail account is NOT designed for bulk transactional
# sending — Google's abuse detection can restrict the whole account under sustained
# volume (live-confirmed in this project, see DECISIONS.md D75). For anything beyond
# low-volume/dev use, a dedicated transactional provider (AWS SES, SendGrid,
# Postmark) is the durable fix, not a bigger Gmail account.

# === Google reCAPTCHA v3 ===
RECAPTCHA_SECRET_KEY=                       # server-side secret (never sent to browser)

# === AWS S3 (resume / logo / certificate uploads via presigned PUT) ===
AWS_REGION=ap-south-1
AWS_BASE_URL=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The bucket needs a public-read policy on GetObject if the frontend renders these
# URLs directly (e.g. <img src={logoUrl}>) — see PRE_DEPLOY_SECURITY_AUDIT.md.

# === Wylto WhatsApp (OTP verification) ===
# Set here for dev, or via Admin → Config → API Keys for prod (no restart needed).
WYLTO_API_TOKEN=

# === RAZORPAY PAYMENTS ===
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                    # generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# === Web Push (VAPID) ===
VAPID_PUBLIC_KEY=                           # generate: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-business-domain.com
